{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "livemuseum/carousel-flat",
	"version": "1.0.0",
	"title": "LiveMuseum — Carousel Flat",
	"category": "widgets",
	"icon": "screenoptions",
	"description": "Carousel orizzontale con card unificate (immagine + testo). Sorgente post configurabile: tutti, categoria corrente, categorie selezionate, oppure modalità related (stessi tag/categorie).",
	"textdomain": "livemuseum",
	"supports": {
		"html": false,
		"align": [ "full", "wide" ]
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "News"
		},
		"linkLabel": {
			"type": "string",
			"default": "Scopri di più"
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"variant": {
			"type": "string",
			"default": "arch",
			"enum": [ "arch", "square" ]
		},
		"postSource": {
			"type": "string",
			"default": "all",
			"enum": [
				"all",
				"current_category",
				"fixed_categories",
				"same_tags",
				"same_categories",
				"same_tags_or_categories"
			]
		},
		"categoryIds": {
			"type": "array",
			"default": [],
			"items": { "type": "number" }
		},
		"postCount": {
			"type": "number",
			"default": 20
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.js",
	"style": "file:./style-index.css"
}
